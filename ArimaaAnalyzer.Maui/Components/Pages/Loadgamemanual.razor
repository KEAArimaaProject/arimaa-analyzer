@page "/loadgamemanual"
@using ArimaaAnalyzer.Maui.Models
@using ArimaaAnalyzer.Maui.Services
@using ArimaaAnalyzer.Maui.Services.Arimaa
@using Microsoft.AspNetCore.Components
@inject ArimaaGameService Game
@inject NavigationManager Nav
@inject PastedGameLibraryService PastedGames

<p>Page to load games manually from Arimaa.com</p>

<div class="mb-3">
    <button class="btn btn-primary"
            @onclick="LoadGame"
            disabled="@(_saving || !IsNameValidForSubmit)">
        Load Game
    </button>
</div>

<div class="mb-3">
    <label for="gameName" class="form-label">Name</label>
    <input id="gameName"
           type="text"
           class="form-control @NameInputCssClass"
           autocomplete="off"
           spellcheck="false"
           aria-required="true"
           aria-invalid="@(_nameTouched && !string.IsNullOrEmpty(_nameError)).ToString().ToLowerInvariant()"
           aria-describedby="gameNameHelp gameNameCount gameNameError"
           value="@GameName"
           @oninput="OnNameInput"
           @onblur="OnNameBlur"
           placeholder="e.g. My study game" />
    <div id="gameNameHelp" class="form-text">
        @PastedGameEntry.NameMinLength–@PastedGameEntry.NameMaxLength characters, must be unique.
        Leading and trailing spaces are ignored.
    </div>
    <div id="gameNameCount" class="form-text name-count @NameCountCssClass" aria-live="polite">
        @_nameLength / @PastedGameEntry.NameMaxLength
        @if (_nameLength > 0 && _nameLength < PastedGameEntry.NameMinLength)
        {
            <span class="name-hint"> — too short</span>
        }
        else if (_nameLength > PastedGameEntry.NameMaxLength)
        {
            <span class="name-hint"> — too long</span>
        }
    </div>
    @if (_nameTouched && !string.IsNullOrEmpty(_nameError))
    {
        <div id="gameNameError" class="invalid-feedback d-block" role="alert">
            @_nameError
        </div>
    }
</div>

<div class="mb-3">
    <label for="gameNotation" class="form-label">Enter Arimaa game notation:</label>
    <textarea id="gameNotation" class="form-control" rows="15" @bind="GameNotation"
              placeholder="Paste the full game notation here..."></textarea>
</div>

@if (ErrorMessages?.Count > 0)
{
    <div class="alert alert-danger">
        <strong>Validation errors:</strong>
        <ul>
            @foreach (var err in ErrorMessages)
            {
                <li>@err</li>
            }
        </ul>
    </div>
}

@if (LoadedSuccessfully)
{
    <div class="alert alert-success">
        Game loaded successfully. Redirecting to board...
    </div>
    <pre class="border p-3 bg-light" style="max-height: 500px; overflow-y: auto;">@GameNotation</pre>
}

@code {
    private string? GameNotation { get; set; }
    private string GameName { get; set; } = string.Empty;
    private bool LoadedSuccessfully { get; set; }
    private bool _saving;
    private bool _nameTouched;
    private string? _nameError;
    private List<string> ErrorMessages { get; set; } = new();

    private int _nameLength => GameName.Trim().Length;

    private bool IsNameValidForSubmit =>
        _nameLength >= PastedGameEntry.NameMinLength
        && _nameLength <= PastedGameEntry.NameMaxLength
        && string.IsNullOrEmpty(_nameError);

    private string NameInputCssClass =>
        !_nameTouched ? string.Empty
        : string.IsNullOrEmpty(_nameError) && _nameLength >= PastedGameEntry.NameMinLength ? "is-valid"
        : "is-invalid";

    private string NameCountCssClass =>
        _nameLength > PastedGameEntry.NameMaxLength ? "text-danger"
        : _nameLength > 0 && _nameLength < PastedGameEntry.NameMinLength ? "text-warning"
        : _nameLength >= PastedGameEntry.NameMinLength ? "text-muted"
        : "text-muted";

    private async Task OnNameInput(ChangeEventArgs e)
    {
        GameName = e.Value?.ToString() ?? string.Empty;
        _nameTouched = true;
        await RefreshNameValidationAsync();
    }

    private async Task OnNameBlur()
    {
        _nameTouched = true;
        await RefreshNameValidationAsync();
    }

    private async Task RefreshNameValidationAsync()
    {
        var trimmed = GameName.Trim();
        if (trimmed.Length == 0)
        {
            _nameError = _nameTouched ? $"Name must be at least {PastedGameEntry.NameMinLength} characters." : null;
            return;
        }

        if (trimmed.Length < PastedGameEntry.NameMinLength)
        {
            _nameError = $"Name is too short ({trimmed.Length} of {PastedGameEntry.NameMinLength} minimum).";
            return;
        }

        if (trimmed.Length > PastedGameEntry.NameMaxLength)
        {
            _nameError = $"Name is too long ({trimmed.Length} of {PastedGameEntry.NameMaxLength} maximum).";
            return;
        }

        try
        {
            if (!await PastedGames.IsNameAvailableAsync(trimmed))
            {
                _nameError = "That name is already in use. Choose a unique name.";
                return;
            }
        }
        catch
        {
            // Uniqueness check failed (storage); length checks still apply.
        }

        _nameError = null;
    }

    private async Task LoadGame()
    {
        ErrorMessages.Clear();
        LoadedSuccessfully = false;
        _nameTouched = true;
        await RefreshNameValidationAsync();

        if (!IsNameValidForSubmit)
        {
            if (!string.IsNullOrEmpty(_nameError))
                ErrorMessages.Add(_nameError);
            else
                ErrorMessages.Add($"Enter a unique name ({PastedGameEntry.NameMinLength}–{PastedGameEntry.NameMaxLength} characters).");
            return;
        }

        var input = GameNotation ?? string.Empty;
        var result = NotationService.ValidatePastedGame(input);
        if (!result.IsValid)
        {
            ErrorMessages.AddRange(result.Errors);
            return;
        }

        // Use parsed root from validation (fallback to re-parse if absent)
        var root = result.Root ?? NotationService.ExtractTurnsWithMoves(input);
        if (root is null)
        {
            ErrorMessages.Add("Unable to parse moves from the provided notation.");
            return;
        }

        try
        {
            _saving = true;
            // Persist for later re-open on Load game list (name + notation)
            await PastedGames.AddAsync(input, GameName);
        }
        catch (Exception ex)
        {
            ErrorMessages.Add($"Could not save the game to the local list: {ex.GetBaseException().Message}");
            return;
        }
        finally
        {
            _saving = false;
        }

        Game.SetSelectedRecord(null);
        Game.Load(root);
        Game.ShowOuterUi = true;
        LoadedSuccessfully = true;

        // Navigate to the main Arimaa page to display the loaded game
        Nav.NavigateTo("/arimaa");
    }
}