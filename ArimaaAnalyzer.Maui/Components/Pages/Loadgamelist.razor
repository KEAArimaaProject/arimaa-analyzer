@page "/loadgamelist"
@using ArimaaAnalyzer.Maui.Models
@using ArimaaAnalyzer.Maui.Services
@using ArimaaAnalyzer.Maui.Services.Arimaa
@using Microsoft.AspNetCore.Components
@inject ArimaaGameService Game
@inject NavigationManager Nav
@inject PastedGameLibraryService PastedGames

<h1>Load game list</h1>

<div class="gamesearch-layout loadgamelist-layout">
    <div class="gs-right">
        <div class="gs-card">
            @if (_loading)
            {
                <div>Loading games…</div>
            }
            else
            {
                <div class="gr-list pgl-list">
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">@_errorMessage</div>
                    }
                    <div class="gr-toolbar">
                        <span class="gr-title">Pasted games (@_games.Count)</span>
                        <div class="pgl-sort" role="group" aria-label="Sort list">
                            <span class="pgl-sort-label">Sort by</span>
                            <button type="button"
                                    class="pgl-sort-btn @(_sortBy is PastedGameSortBy.DateNewestFirst or PastedGameSortBy.DateOldestFirst ? "active" : null)"
                                    title="@(_sortBy == PastedGameSortBy.DateOldestFirst ? "Oldest first (click for newest)" : "Newest first (click for oldest)")"
                                    @onclick="ToggleSortDate">
                                Date @DateSortIndicator
                            </button>
                            <button type="button"
                                    class="pgl-sort-btn @(_sortBy is PastedGameSortBy.NameAscending or PastedGameSortBy.NameDescending ? "active" : null)"
                                    title="@(_sortBy == PastedGameSortBy.NameDescending ? "Z–A (click for A–Z)" : "A–Z (click for Z–A)")"
                                    @onclick="ToggleSortName">
                                Name @NameSortIndicator
                            </button>
                        </div>
                    </div>
                    <p class="pgl-hint">
                        Click a row to open the game on the board.
                        @if (ShowDeleteButtons)
                        {
                            <text> Use × to remove a saved game.</text>
                        }
                    </p>

                    @if (_games.Count == 0)
                    {
                        <div class="gr-empty">
                            No pasted games yet. Paste a game on
                            <a href="loadgamemanual">Load game manual</a>
                            first.
                        </div>
                    }
                    else
                    {
                        <div class="table-wrap pgl-scroll">
                            <table class="table table-sm table-hover @(ShowDeleteButtons ? "pgl-table-with-actions" : null)">
                                <thead>
                                <tr>
                                    @if (ShowDeleteButtons)
                                    {
                                        <th class="pgl-col-actions" scope="col">
                                            <span class="visually-hidden">Actions</span>
                                        </th>
                                    }
                                    <th class="pgl-col-name">Name</th>
                                    <th class="pgl-col-date">Added (yyyymmdd_hh:mm)</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var g in _games)
                                {
                                    <tr class="gr-row"
                                        role="button"
                                        tabindex="0"
                                        title="Click to load this game on the main board"
                                        @onclick="() => HandleSelect(g)"
                                        @onkeydown="(e) => OnRowKeyDown(e, g)">
                                        @if (ShowDeleteButtons)
                                        {
                                            <td class="pgl-actions" @onclick:stopPropagation="true">
                                                <button type="button"
                                                        class="pgl-delete-btn"
                                                        title="Delete @g.Name"
                                                        aria-label="Delete @g.Name"
                                                        disabled="@(_deletingId == g.Id)"
                                                        @onclick="() => HandleDeleteAsync(g)">
                                                    @if (_deletingId == g.Id)
                                                    {
                                                        <span aria-hidden="true">…</span>
                                                    }
                                                    else
                                                    {
                                                        <span aria-hidden="true">×</span>
                                                    }
                                                </button>
                                            </td>
                                        }
                                        <td class="pgl-name">@g.Name</td>
                                        <td class="pgl-timestamp">@g.DisplayTimestamp</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>Cascaded from MainLayout top-bar Delete On/Off toggle.</summary>
    [CascadingParameter(Name = "ShowPastedGameDeleteButtons")]
    private bool ShowDeleteButtons { get; set; }

    private List<PastedGameEntry> _games = new();
    private bool _loading = true;
    private string? _errorMessage;
    private PastedGameSortBy _sortBy = PastedGameSortBy.DateNewestFirst;
    private Guid? _deletingId;

    private string DateSortIndicator => _sortBy switch
    {
        PastedGameSortBy.DateNewestFirst => "↓",
        PastedGameSortBy.DateOldestFirst => "↑",
        _ => "",
    };

    private string NameSortIndicator => _sortBy switch
    {
        PastedGameSortBy.NameAscending => "↑",
        PastedGameSortBy.NameDescending => "↓",
        _ => "",
    };

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            _errorMessage = null;
            _loading = true;
            var items = await PastedGames.GetAllAsync(_sortBy);
            _games = items.ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load pasted games: {ex.GetBaseException().Message}";
            _games = new List<PastedGameEntry>();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ToggleSortDate()
    {
        _sortBy = _sortBy == PastedGameSortBy.DateNewestFirst
            ? PastedGameSortBy.DateOldestFirst
            : PastedGameSortBy.DateNewestFirst;
        await ReloadAsync();
    }

    private async Task ToggleSortName()
    {
        _sortBy = _sortBy == PastedGameSortBy.NameAscending
            ? PastedGameSortBy.NameDescending
            : PastedGameSortBy.NameAscending;
        await ReloadAsync();
    }

    private void OnRowKeyDown(KeyboardEventArgs e, PastedGameEntry entry)
    {
        if (e.Key is "Enter" or " ")
            HandleSelect(entry);
    }

    private void HandleSelect(PastedGameEntry entry)
    {
        try
        {
            _errorMessage = null;
            Game.SetSelectedRecord(null);

            var root = PastedGameLibraryService.MaterializeRoot(entry);
            if (root is null)
            {
                _errorMessage = "Unable to load the selected game's tree (missing or invalid data).";
                return;
            }

            // Open at root (start of the saved game)
            Game.Load(root);
            Game.ShowOuterUi = true;
            Nav.NavigateTo("/arimaa");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load game: {ex.GetBaseException().Message}";
        }
    }

    private async Task HandleDeleteAsync(PastedGameEntry entry)
    {
        if (_deletingId is not null)
            return;

        try
        {
            _errorMessage = null;
            _deletingId = entry.Id;
            var removed = await PastedGames.DeleteAsync(entry.Id);
            if (!removed)
            {
                _errorMessage = "That game was already removed.";
            }

            _games.RemoveAll(g => g.Id == entry.Id);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to delete game: {ex.GetBaseException().Message}";
        }
        finally
        {
            _deletingId = null;
        }
    }
}