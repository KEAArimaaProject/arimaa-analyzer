@using ArimaaAnalyzer.Maui.Services
@using ArimaaAnalyzer.Maui.Services.Arimaa
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject HotkeyService Hotkeys
@inject ArimaaGameService Game
@inject IJSRuntime JS

@code {
    [Parameter]
    public bool IsOnArimaaPage { get; set; }

    [Parameter]
    public Func<bool> IsAnalysisInProgress { get; set; } = () => false;

    [Parameter]
    public Func<Sides, Task> OnAnalyze { get; set; } = _ => Task.CompletedTask;

    private DotNetObjectReference<HotkeyHost>? _dotNetRef;
    private IJSObjectReference? _module;

    protected override void OnParametersSet()
    {
        RegisterHandlers();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _dotNetRef = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/hotkeys.js");
        await _module.InvokeVoidAsync("connect", _dotNetRef);
    }

    [JSInvokable]
    public async Task OnKeyDown(string key)
    {
        await Hotkeys.TryHandleAsync(key);
    }

    private void RegisterHandlers()
    {
        Hotkeys.Register(HotkeyAction.PrevTurn, HandlePrevTurnAsync, () => IsOnArimaaPage && Game.CanPrev);
        Hotkeys.Register(HotkeyAction.NextTurn, HandleNextTurnAsync, () => IsOnArimaaPage && Game.CanNext);
        Hotkeys.Register(HotkeyAction.GoToStart, HandleGoToStartAsync, () => IsOnArimaaPage && Game.CanGoToStart);
        Hotkeys.Register(HotkeyAction.GoToEnd, HandleGoToEndAsync, () => IsOnArimaaPage && Game.CanGoToEnd);
        Hotkeys.Register(HotkeyAction.AnalyzeGold, () => OnAnalyze(Sides.Gold), () => IsOnArimaaPage && !IsAnalysisInProgress());
        Hotkeys.Register(HotkeyAction.AnalyzeSilver, () => OnAnalyze(Sides.Silver), () => IsOnArimaaPage && !IsAnalysisInProgress());
    }

    private Task HandlePrevTurnAsync()
    {
        Game.GoPrev();
        return Task.CompletedTask;
    }

    private Task HandleNextTurnAsync()
    {
        Game.GoNextMainLine();
        return Task.CompletedTask;
    }

    private Task HandleGoToStartAsync()
    {
        Game.GoToStart();
        return Task.CompletedTask;
    }

    private Task HandleGoToEndAsync()
    {
        Game.GoToEnd();
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disconnect");
                await _module.DisposeAsync();
            }
            catch
            {
                /* ignore on shutdown */
            }

            _module = null;
        }

        _dotNetRef?.Dispose();
    }
}