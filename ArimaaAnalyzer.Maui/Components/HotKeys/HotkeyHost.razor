@using ArimaaAnalyzer.Maui.Services
@using ArimaaAnalyzer.Maui.Services.Arimaa
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject HotkeyService Hotkeys
@inject ArimaaGameService Game
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Invisible host so Blazor runs full lifecycle (OnAfterRender) for this component. *@
<div class="hotkey-host" aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden;"></div>

@code {
    [Parameter]
    public bool IsOnArimaaPage { get; set; }

    [Parameter]
    public Func<bool> IsAnalysisInProgress { get; set; } = () => false;

    [Parameter]
    public Func<Sides, Task> OnAnalyze { get; set; } = _ => Task.CompletedTask;

    private DotNetObjectReference<HotkeyHost>? _dotNetRef;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        RegisterHandlers();
    }

    protected override void OnParametersSet()
    {
        RegisterHandlers();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await EnsureConnectedAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        RegisterHandlers();
        _ = EnsureConnectedAsync();
    }

    private async Task EnsureConnectedAsync()
    {
        try
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            // index.html defines window.__arimaaHotkeysSetRef and a permanent keydown listener.
            await JS.InvokeVoidAsync("__arimaaHotkeysSetRef", _dotNetRef);
        }
        catch
        {
            /* JS not ready yet; will retry on next render / navigation */
        }
    }

    [JSInvokable]
    public Task OnKeyDown(string key)
    {
        // Marshal onto the Blazor renderer sync context so board re-renders after Load().
        return InvokeAsync(async () =>
        {
            await Hotkeys.TryHandleAsync(key);
            StateHasChanged();
        });
    }

    private void RegisterHandlers()
    {
        // Gate on game capability only — not AbsolutePath. MAUI WebView URIs often fail strict
        // path checks, which previously blocked hotkeys while board buttons still worked.
        Hotkeys.Register(HotkeyAction.PrevTurn, HandlePrevTurnAsync, () => Game.CanPrev);
        Hotkeys.Register(HotkeyAction.NextTurn, HandleNextTurnAsync, () => Game.CanNext);
        Hotkeys.Register(HotkeyAction.GoToStart, HandleGoToStartAsync, () => Game.CanGoToStart);
        Hotkeys.Register(HotkeyAction.GoToEnd, HandleGoToEndAsync, () => Game.CanGoToEnd);
        Hotkeys.Register(HotkeyAction.AnalyzeGold, () => OnAnalyze(Sides.Gold), () => IsArimaaContext && !IsAnalysisInProgress());
        Hotkeys.Register(HotkeyAction.AnalyzeSilver, () => OnAnalyze(Sides.Silver), () => IsArimaaContext && !IsAnalysisInProgress());
    }

    /// <summary>
    /// True when layout says we're on Arimaa, URI mentions arimaa, or a game tree is loaded.
    /// </summary>
    private bool IsArimaaContext
    {
        get
        {
            if (IsOnArimaaPage) return true;
            if (Game.CurrentNode is not null) return true;

            var uri = Nav.Uri ?? string.Empty;
            if (uri.Contains("arimaa", StringComparison.OrdinalIgnoreCase))
                return true;

            try
            {
                var rel = Nav.ToBaseRelativePath(Nav.Uri).Trim().Trim('/');
                return rel.Equals("arimaa", StringComparison.OrdinalIgnoreCase)
                       || rel.StartsWith("arimaa?", StringComparison.OrdinalIgnoreCase)
                       || rel.StartsWith("arimaa/", StringComparison.OrdinalIgnoreCase);
            }
            catch
            {
                return false;
            }
        }
    }

    private Task HandlePrevTurnAsync()
    {
        Game.GoPrev();
        return Task.CompletedTask;
    }

    private Task HandleNextTurnAsync()
    {
        Game.GoNextMainLine();
        return Task.CompletedTask;
    }

    private Task HandleGoToStartAsync()
    {
        Game.GoToStart();
        return Task.CompletedTask;
    }

    private Task HandleGoToEndAsync()
    {
        Game.GoToEnd();
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;

        try
        {
            await JS.InvokeVoidAsync("eval", "if(window.arimaaHotkeys){window.arimaaHotkeys.ref=null;}");
        }
        catch
        {
            /* ignore on shutdown */
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;
        await Task.CompletedTask;
    }
}