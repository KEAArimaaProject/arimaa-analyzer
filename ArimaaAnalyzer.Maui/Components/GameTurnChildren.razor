@using ArimaaAnalyzer.Maui.Models
@using ArimaaAnalyzer.Maui.Services
@using ArimaaAnalyzer.Maui.Services.Arimaa
@using Microsoft.AspNetCore.Components
@implements IDisposable

<div class="gtc-container">
    @if (Game?.CurrentNode is null)
    {
        <div class="gtc-empty">No active node</div>
    }
    else if (Game.CurrentNode.Children is { Count: > 0 } children)
    {
        @if (!string.IsNullOrWhiteSpace(Game.PendingMoveText))
        {
            <div class="gtc-pending" title="Pending moves that can be reset or committed">
                Pending: @Game.PendingMoveText
            </div>
        }
        @foreach (var child in children)
        {
            var label = FormatChildLabel(Game.CurrentNode, child);
            <button class="gtc-item"
                    title="Go to this variation: @label"
                    @onclick="() => Game.Load(child)">
                @label
            </button>
        }
    }
    else
    {
        <div class="gtc-empty">No children</div>
        @if (!string.IsNullOrWhiteSpace(Game.PendingMoveText))
        {
            <div class="gtc-pending" title="Pending moves that can be reset or committed">
                Pending: @Game.PendingMoveText
            </div>
        }
    }
</div>

@code {
    [Parameter]
    [EditorRequired]
    public ArimaaGameService Game { get; set; } = default!;

    protected override void OnInitialized()
    {
        if (Game is not null)
        {
            Game.CurrentNodeChanged += OnCurrentNodeChanged;
            Game.StateChanged += OnStateChanged;
        }
    }

    private void OnCurrentNodeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Label for a child variation. Stored Moves is preferred; when empty (HumanMove /
    /// side-sync nodes), derive notation or a clear fallback from parent→child AEI.
    /// </summary>
    private static string FormatChildLabel(GameTurn parent, GameTurn child)
    {
        var stored = string.Join(" ", child.Moves ?? Array.Empty<string>()).Trim();
        if (!string.IsNullOrWhiteSpace(stored))
            return stored;

        // Try legal Arimaa step notation from AEI transition
        try
        {
            var before = new GameState(parent.AEIstring);
            var after = new GameState(child.AEIstring);
            var (notation, aei) = CorrectMoveService.ComputeMoveSequence(before, after);
            if (!string.IsNullOrWhiteSpace(notation)
                && !string.Equals(notation, "error", StringComparison.Ordinal)
                && !string.Equals(aei, "error", StringComparison.Ordinal))
            {
                return notation;
            }
        }
        catch
        {
            /* fall through to descriptive fallbacks */
        }

        var nextSide = DescribeSideToMove(child.AEIstring, child.Side);

        // Side flip only (same board, different side letter)
        if (SameBoardPayload(parent.AEIstring, child.AEIstring))
            return $"pass ({nextSide} to move)";

        // Freeform board edit that couldn't be notated as a legal turn
        return $"setup ({nextSide} to move)";
    }

    private static string DescribeSideToMove(string aei, Sides fallback)
    {
        try
        {
            var side = new GameState(aei).SideToMove;
            return side == Sides.Gold ? "Gold" : "Silver";
        }
        catch
        {
            return fallback == Sides.Gold ? "Gold" : "Silver";
        }
    }

    /// <summary>
    /// Compare the 64-char board payloads, ignoring the side-to-move letter.
    /// </summary>
    private static bool SameBoardPayload(string aeiA, string aeiB)
    {
        var boardA = ExtractBoardPayload(aeiA);
        var boardB = ExtractBoardPayload(aeiB);
        if (boardA is null || boardB is null) return false;
        return string.Equals(boardA, boardB, StringComparison.Ordinal);
    }

    private static string? ExtractBoardPayload(string aei)
    {
        if (string.IsNullOrWhiteSpace(aei)) return null;
        var first = aei.IndexOf('"');
        var last = aei.LastIndexOf('"');
        if (first < 0 || last <= first) return null;
        var payload = aei.Substring(first + 1, last - first - 1);
        return payload.Length == 64 ? payload : null;
    }

    public void Dispose()
    {
        if (Game is not null)
        {
            Game.CurrentNodeChanged -= OnCurrentNodeChanged;
            Game.StateChanged -= OnStateChanged;
        }
    }
}
