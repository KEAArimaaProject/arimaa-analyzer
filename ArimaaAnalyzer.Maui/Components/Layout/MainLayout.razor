@inherits LayoutComponentBase
@using ArimaaAnalyzer.Maui.Components
@using ArimaaAnalyzer.Maui.Services
@using ArimaaAnalyzer.Maui.Services.Arimaa
@using System.Linq
@using System.Collections.Generic
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ArimaaGameService Game
@inject MiniBoardsCoordinator MiniBoards
@inject AnalysisService Analysis
@implements IDisposable

<div class="page">
    <NavMenu/>

    <main class="page-wrapper">
        <div class="top-row px-4">
            <label for="nav-toggle" class="burger-button" title="Open menu" aria-label="Open navigation menu"></label>
            @if (IsOnArimaaPage)
            {
                <!-- Current game quick info (takes lowest priority in flex; shrinks before buttons) -->
                <div class="current-game-info" title="Current game summary">
                    @if (Game?.SelectedRecord is { } r)
                    {
                        <span class="cg-item start">@FormatDate(r.StartTs)</span>
                        <span class="cg-sep">•</span>
                        <span class="cg-item result">@FormatSide(r.ResultSide)</span>
                        <span class="cg-sep">•</span>
                        <span class="cg-item gold" title="Gold">@NullSafe(r.WUsername)</span>
                        <span class="cg-item rating gold-rating">(@FormatInt(r.WRating))</span>
                        <span class="cg-sep">vs</span>
                        <span class="cg-item silver" title="Silver">@NullSafe(r.BUsername)</span>
                        <span class="cg-item rating silver-rating">(@FormatInt(r.BRating))</span>
                        <span class="cg-sep">•</span>
                        <span class="cg-item time" title="Time control">@NullSafe(r.TimeControl)</span>
                    }
                    else
                    {
                        
                        <span class="cg-empty">No game</span>
                    }
                </div>
                
                @if (_sharedSettings.Play)
                {
                    <button class="human-play" @onclick="Humanmove" disabled="@_analysisInProgress">
                        HumanMove
                    </button>
                }
                <button class="analyze-position" @onclick="() => AnalyzePosition(Sides.Gold)" disabled="@_analysisInProgress"
                        title="Analyze / move with Gold moving first">
                    MoveG
                </button>
                <button class="analyze-position" @onclick="() => AnalyzePosition(Sides.Silver)" disabled="@_analysisInProgress"
                        title="Analyze / move with Silver moving first">
                    MoveS
                </button>
                <button class="toggle-outer-ui" @onclick="ToggleOuterUi">
                    Toggle Outer UI (@(_sharedSettings.ShowOuterUi ? "On" : "Off"))
                </button>
                <button class="play-with-ai" @onclick="PlayWithAi" disabled="@_analysisInProgress">
                    Play (@(_sharedSettings.Play ? "On" : "Off"))
                </button>
            }
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content">
            <CascadingValue Value="_sharedSettings">
                @Body
            </CascadingValue>
        </article>
    </main>
</div>

@code {
    private readonly ArimaaBoardSettings _sharedSettings = ArimaaBoardSettings.PlayableLargeWithUi;

    private bool _analysisInProgress;

    private async Task Humanmove()
    {
        // Flip side-to-move relative to the board, then analyze for that side
        if (Game is null || Game.State is null) return;

        try
        {
            SyncAeiWithBoard();
            var flippedSide = Game.State.SideToMove == Sides.Gold ? Sides.Silver : Sides.Gold;
            StateHasChanged();
            await AnalyzePosition(flippedSide);
        }
        catch { /* ignore flip errors for now */ }
    }

    /// <summary>
    /// Sync board AEI, then if needed flip side-to-move so the AI's first move is for <paramref name="desiredSide"/>.
    /// </summary>
    private void EnsureSideToMove(Sides desiredSide)
    {
        if (Game is null || Game.State is null) return;

        SyncAeiWithBoard();

        if (Game.State.SideToMove == desiredSide) return;

        var currentNode = Game.CurrentNode ?? Game.State.CurrentNode;
        var baseAei = Game.State.localAeiSetPosition;
        var flippedAei = FlipSideInAei(baseAei);
        var moveNumber = currentNode?.MoveNumber ?? "0";

        var child = new ArimaaAnalyzer.Maui.Models.GameTurn(
            oldAEIstring: baseAei,
            updatedAEIstring: flippedAei,
            MoveNumber: moveNumber,
            Side: desiredSide,
            Moves: new List<string>(),
            isMainLine: false);

        if (currentNode is not null)
        {
            try { currentNode.AddChild(child); } catch { /* ignore attach issues */ }
        }

        Game.Load(child);
    }
    
    // Ensure the active node AEI matches the current on-screen board state (Game.State.localAeiSetPosition)
    private void SyncAeiWithBoard()
    {
        if (Game is null || Game.State is null) return;
        var currentNode = Game.CurrentNode ?? Game.State.CurrentNode;
        var liveAei = Game.State.localAeiSetPosition;
        if (string.IsNullOrWhiteSpace(liveAei)) return;

        var nodeAei = currentNode?.AEIstring;
        if (!string.Equals(nodeAei, liveAei, StringComparison.Ordinal))
        {
            var moveNumber = currentNode?.MoveNumber ?? "0";
            var side = Game.State.SideToMove;

            var child = new ArimaaAnalyzer.Maui.Models.GameTurn(
                oldAEIstring: nodeAei ?? liveAei,
                updatedAEIstring: liveAei,
                MoveNumber: moveNumber,
                Side: side,
                Moves: new List<string>(),
                isMainLine: false);

            if (currentNode is not null)
            {
                try { currentNode.AddChild(child); } catch { /* ignore attach issues */ }
            }

            Game.Load(child);
        }
    }
    
    private void ToggleOuterUi()
    {
        _sharedSettings.ShowOuterUi = !_sharedSettings.ShowOuterUi;
        // Components reading this setting will update on next render
        StateHasChanged();
    }

    private static string FlipSideInAei(string aei)
    {
        if (string.IsNullOrWhiteSpace(aei)) return aei;
        var trimmed = aei.TrimStart();
        const string prefix = "setposition ";
        var idx = trimmed.IndexOf(prefix, StringComparison.OrdinalIgnoreCase);
        if (idx != 0) return aei; // unexpected format, leave as-is
        var after = trimmed.Substring(prefix.Length);
        if (after.Length == 0) return aei;
        var side = char.ToLowerInvariant(after[0]);
        char flipped = side == 'g' ? 's' : 'g';
        // rebuild string preserving the rest
        var rest = after.Length > 1 ? after.Substring(1) : string.Empty;
        var rebuilt = $"{prefix}{flipped}{rest}";
        // Keep original leading whitespace if any
        var leadingLen = aei.Length - aei.TrimStart().Length;
        return (leadingLen > 0 ? aei.Substring(0, leadingLen) : string.Empty) + rebuilt;
    }
    
    private void PlayWithAi()
    {
        _sharedSettings.Play = !_sharedSettings.Play;
        // Components reading this setting will update on next render
        StateHasChanged();
    }

    private async Task AnalyzePosition(Sides firstSide)
    {
        if (_analysisInProgress) return;
        _analysisInProgress = true;
        try
        {
            // Force which side the AI moves first (Gold or Silver)
            EnsureSideToMove(firstSide);
            StateHasChanged();

            var sideLabel = firstSide == Sides.Gold ? "Gold" : "Silver";

            // Decide branch based on Play flag
            if (_sharedSettings.Play)
            {
                await JS.InvokeVoidAsync("eval", $"console.log('AnalyzePosition: Play=true, firstSide={sideLabel} -> one-turn analyze-and-move')");
                await AnalyzePosition_PlayOneTurnAsync();
            }
            else
            {
                await JS.InvokeVoidAsync("eval", $"console.log('AnalyzePosition: Play=false, firstSide={sideLabel} -> analyze-only (mini-boards)')");
                await AnalyzePosition_AnalyzeOnlyAsync();
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("eval", $"console.error('AnalyzePosition failed: '+ {System.Text.Json.JsonSerializer.Serialize(ex.Message)})");
        }
        finally
        {
            _analysisInProgress = false;
        }
    }

    // New: analyze-only path (preserves existing behavior)
    private async Task AnalyzePosition_AnalyzeOnlyAsync()
    {
        await JS.InvokeVoidAsync("eval", "console.log('AnalyzePosition_AnalyzeOnlyAsync: invoked')");
        var isOnArimaa = IsOnArimaaPage;
        await JS.InvokeVoidAsync("eval", $"console.log('AnalyzePosition_AnalyzeOnlyAsync: IsOnArimaaPage=' + {System.Text.Json.JsonSerializer.Serialize(isOnArimaa)})");
        await JS.InvokeVoidAsync("eval", $"console.log('AnalyzePosition_AnalyzeOnlyAsync: Nav.Uri=' + {System.Text.Json.JsonSerializer.Serialize(Nav?.Uri ?? "null")})");

        if (Game is null)
        {
            await JS.InvokeVoidAsync("eval", "console.error('AnalyzePosition_AnalyzeOnlyAsync: Game service is null (DI not available).')");
            return;
        }
        if (Game.State is null)
        {
            await JS.InvokeVoidAsync("eval", "console.error('AnalyzePosition_AnalyzeOnlyAsync: Game.State is null.')");
            return;
        }

        var root = Game?.State?.CurrentNode;
        if (root is null)
        {
            await JS.InvokeVoidAsync("eval", "console.warn('AnalyzePosition_AnalyzeOnlyAsync: No CurrentNode available in game state.')");
            return;
        }

        var depth = MiniBoards?.Count ?? 0; // depth equals number of mini boards
        await JS.InvokeVoidAsync("eval", $"console.log('AnalyzePosition_AnalyzeOnlyAsync: streaming BuildGameTurnStreamAsync(depth='+{depth}+') with CurrentNode')");

        // Wipe existing mini-board visuals so the user can clearly see new updates coming in
        if (MiniBoards is not null && depth > 0)
        {
            MiniBoards.WipeAll();
            await JS.InvokeVoidAsync("eval", "console.log('AnalyzePosition_AnalyzeOnlyAsync: mini-boards wiped to neutral state')");
        }

        var idx = 0;
        var max = depth;
        var sw = System.Diagnostics.Stopwatch.StartNew();
        await foreach (var genNode in Analysis.BuildGameTurnStreamAsync(root, maxDepth: max, timetothink: _sharedSettings.ThinkInt))
        {
            // Update the corresponding mini board immediately
            if ((MiniBoards?.Count ?? 0) > 0 && idx < MiniBoards.Count)
            {
                MiniBoards.SetNode(idx, genNode);
            }

            idx++;
            if (idx >= max) break;
        }
        sw.Stop();
        var elapsedMs = sw.ElapsedMilliseconds;
        await JS.InvokeVoidAsync("eval", $"console.log('AnalyzePosition_AnalyzeOnlyAsync: streaming complete in '+{elapsedMs}+' ms; nodes='+{idx})");
    }

    // New: one-turn analyze and apply move to main board
    private async Task AnalyzePosition_PlayOneTurnAsync()
    {
        await JS.InvokeVoidAsync("eval", "console.log('AnalyzePosition_PlayOneTurnAsync: invoked')");

        if (Game is null)
        {
            await JS.InvokeVoidAsync("eval", "console.error('AnalyzePosition_PlayOneTurnAsync: Game service is null (DI not available).')");
            return;
        }
        if (Game.State is null)
        {
            await JS.InvokeVoidAsync("eval", "console.error('AnalyzePosition_PlayOneTurnAsync: Game.State is null.')");
            return;
        }

        // Ensure the AEI string (node) reflects the current board position, then re-read current
        // (EnsureSideToMove / SyncAeiWithBoard may have replaced CurrentNode).
        SyncAeiWithBoard();
        var current = Game.State.CurrentNode ?? Game.CurrentNode;
        if (current is null)
        {
            await JS.InvokeVoidAsync("eval", "console.warn('AnalyzePosition_PlayOneTurnAsync: No CurrentNode available in game state.')");
            return;
        }

        // Generate exactly one turn from current position
        ArimaaAnalyzer.Maui.Models.GameTurn? generated = null;
        await foreach (var gen in Analysis.BuildGameTurnStreamAsync(current, maxDepth: 1, timetothink: _sharedSettings.ThinkInt))
        {
            generated = gen;
            break; // only need one
        }

        if (generated is null)
        {
            await JS.InvokeVoidAsync("eval", "console.warn('AnalyzePosition_PlayOneTurnAsync: Engine did not produce a move.')");
            return;
        }

        // Attach as a non-mainline child to avoid violating main-line parent constraints
        var child = new ArimaaAnalyzer.Maui.Models.GameTurn(
            oldAEIstring: current.AEIstring,
            updatedAEIstring: generated.AEIstring,
            MoveNumber: generated.MoveNumber,
            Side: generated.Side,
            Moves: generated.Moves,
            isMainLine: false);

        try
        {
            current.AddChild(child);
        }
        catch (Exception addEx)
        {
            await JS.InvokeVoidAsync("eval", $"console.warn('AnalyzePosition_PlayOneTurnAsync: Could not attach child to current node: '+ {System.Text.Json.JsonSerializer.Serialize(addEx.Message)})");
            // proceed to load the generated move directly
        }

        // Move the main board to the newly generated node
        Game.Load(child);
        await JS.InvokeVoidAsync("eval", $"console.log('AnalyzePosition_PlayOneTurnAsync: Applied move '+{System.Text.Json.JsonSerializer.Serialize(string.Join(' ', child.Moves))}+' and updated main board.')");
    }
    
    private bool IsOnArimaaPage =>
        Nav is not null &&
        Uri.TryCreate(Nav.Uri, UriKind.Absolute, out var uri) &&
        string.Equals(uri.AbsolutePath.TrimEnd('/'), "/arimaa", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        if (Game is not null)
        {
            Game.SelectedRecordChanged += OnSelectedRecordChanged;
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Re-render so the conditional button shows/hides when navigating
        InvokeAsync(StateHasChanged);
    }

    private void OnSelectedRecordChanged()
    {
        // Update header info when a new record is selected
        InvokeAsync(StateHasChanged);
    }


    // Local format helpers (mirror GameRecordList formatting)
    private static string NullSafe(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s!;
    private static string FormatInt(int? v) => v.HasValue ? v.Value.ToString() : "—";
    private static string FormatSide(GameRecord.Side? side)
        => side switch
        {
            GameRecord.Side.Gold => "Gold",
            GameRecord.Side.Silver => "Silver",
            _ => "—"
        };
    private static string FormatDate(DateTimeOffset? dto)
    {
        if (dto is null) return "—";
        var local = dto.Value.ToLocalTime();
        return local.ToString("yyyy-MM-dd HH:mm");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        if (Game is not null)
        {
            Game.SelectedRecordChanged -= OnSelectedRecordChanged;
        }
    }
}